# Local development env template.
# Copy to `.env` (gitignored) for local-only experimentation.
# Real values for the demo come from infra/provision.sh and live in
# .env.demo / .env.rehearsal (also gitignored).

PORT=8080

# Set to "1" to make /products always return 500 (production-failure
# simulation). Off by default locally.
INJECT_ERROR=0

# Optional: connect a local Application Insights resource. The server
# only initialises the SDK if this is set.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Microsoft.App RP preview API version. Bump in one place if Microsoft
# revs the preview between today and Thursday. All scripts and SETUP
# step C calls source this from .env.demo.
SRE_API_VERSION=2026-01-01
